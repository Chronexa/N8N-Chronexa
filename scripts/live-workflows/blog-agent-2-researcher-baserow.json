        }
      }
    },
    {
      "id": "a2b-exa",
      "name": "Exa Deep Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        400
      ],
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "https://api.exa.ai/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "82046c22-fa17-4074-9511-2ff1abbe63a2"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ .first().json.target_keyword }} {{ .first().json.persona.replace(/_/g, ' ') }} statistics data case study operations 2025 2026\",\n  \"numResults\": 5,\n  \"type\": \"auto\",\n  \"startPublishedDate\": \"2025-01-01\",\n  \"contents\": {\n    \"summary\": {\n      \"query\": \"Extract: (1) specific statistics and percentages with sources, (2) real company or firm examples, (3) key operational pain points for the target business persona, (4) financial or efficiency impact numbers. Context: {{ .first().json.thesis }}\"\n    }\n  }\n}",
        "options": {
          "timeout": 60000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a2b-brief",
      "name": "Build Research Brief",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1780,
        280
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "rb-id",
              "name": "record_id",
              "value": "={{ $('Extract Record').first().json.record_id }}",
              "type": "number"
            },
            {
              "id": "rb-brief",
              "name": "research_brief",
              "value": "={{ $json.results.map((r, i) => '## Source ' + (i + 1) + ': ' + r.title + '\nURL: ' + r.url + '\nPublished: ' + (r.publishedDate ? r.publishedDate.substring(0, 10) : 'N/A') + '\n\n' + (r.summary || 'No summary available')).join('\n\n---\n\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
