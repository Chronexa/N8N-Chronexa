    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 1024,\n  messages: [{\n    role: 'user',\n    content: 'You are an expert B2B content strategist for Chronexa.io, an enterprise AI firm that designs secure, auditable custom AI systems for regulated industries: private equity and M&A, wealth management and RIAs, law firms, CPA and tax firms, and financial services. Readers are partners, principals and COOs at US mid-market firms. Workflow tools such as n8n are implementation details, never the story.\\n\\nTarget keyword: ' + $json.query + '\\nKeyword context: ' + ($json.context_line || 'High-opportunity keyword for Chronexa.') + '\\n\\nBrief principles: state the problem exactly as the buyer would phrase it, promise concrete ROI, treat security and compliance as the deal-decider, demand first-hand operational depth. No generic AI content.\\n\\nGenerate a blog post brief using EXACTLY this format with NO extra text before or after:\\n\\n%%TITLE%%\\n[A compelling, specific blog post title targeting this keyword. Max 65 characters.]\\n%%TITLE%%\\n\\n%%KEYWORD%%\\n' + $json.query + '\\n%%KEYWORD%%\\n\\n%%SECONDARY%%\\n[3-5 secondary keywords, comma-separated, semantically related to the main keyword]\\n%%SECONDARY%%\\n\\n%%PERSONA%%\\n[Pick ONE: private_equity, wealth_management, legal, cpa_firm, financial_services]\\n%%PERSONA%%\\n\\n%%THESIS%%\\n[2-3 sentences: the core argument and value of this post for the target persona]\\n%%THESIS%%'\n  }]\n}) }}",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "a1g-claude",
      "name": "Claude Brief Generation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1408,
        368
      ],
      "credentials": {
        "httpHeaderAuth": {
