    {
      "id": "a4-gen-prompt",
      "name": "Generate Image Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 300,\n  \"system\": \"You are an AI art director for a B2B technology firm. Create precise, visual Imagen prompts for blog cover images. Style: professional, abstract, enterprise. No text in images. Think: dark minimalist backgrounds, glowing data flows, geometric patterns, cinematic lighting. Never include people's faces. Never include text or numbers. Return ONLY the prompt string, nothing else.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Create an Imagen 3 prompt for this B2B blog post cover image:\\nTitle: {{ $('Get Pending Record').first().json['Title'] }}\\nThesis: {{ $('Get Pending Record').first().json['Thesis'] }}\\n\\nReturn ONLY the image prompt string (2-3 sentences max).\"\n  }]\n}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MBzkzU0jc7m1gBTJ",
          "name": "Anthropic API"
        }
      }
    },
    {
      "id": "a4-extract-prompt",
      "name": "Extract Image Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-record-id",
              "name": "record_id",
              "value": "={{ $('Get Pending Record').first().json.id }}",
              "type": "string"
            },
            {
              "id": "assign-image-prompt",
              "name": "image_prompt",
              "value": "={{ $json.content[0].text.trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a4-gen-image",
      "name": "Generate Image with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/imagen-3.0-generate-002:predict?key=={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"instances\": [{\n    \"prompt\": \"{{ $json.image_prompt }}. Professional enterprise B2B tech aesthetic, dark background, abstract data visualization, no text, no faces, cinematic quality\"\n  }],\n  \"parameters\": {\n    \"sampleCount\": 1,\n    \"aspectRatio\": \"16:9\",\n    \"outputMimeType\": \"image/png\",\n    \"personGeneration\": \"dont_allow\"\n  }\n}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "a4-upload-imgbb",
      "name": "Upload Image to Imgbb",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        220
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "=https://api.imgbb.com/1/upload?key=7356768e4502c6eec54d7228f1c0d06d&name=blog-{{ $('Extract Image Prompt').first().json.record_id }}",
        "sendHeaders": false,
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "image",
              "value": "={{ $json.predictions[0].bytesBase64Encoded }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
