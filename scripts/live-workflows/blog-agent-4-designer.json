    {
      "id": "a4b-gen-prompt",
      "name": "Generate Image Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 200,\n  \"system\": \"You are an art director for Chronexa, whose blog covers are minimal editorial line illustrations in ONE fixed house style. Given a blog title and thesis, return ONE short motif sentence describing the abstract subject matter as concrete drawable objects flowing through connected isometric nodes. Example: deal documents and company folders flowing through analysis nodes toward a completed transaction handshake. Rules: physical objects only (documents, folders, shields, vaults, scales, building blocks), no text or letters or numbers in the scene, no people, no logos, no screens or UI. Return ONLY the motif sentence, nothing else.\",\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Blog title: {{ $('Extract Record').first().json.title }}\\nThesis: {{ $('Extract Record').first().json.thesis }}\\n\\nReturn ONLY the motif sentence.\"\n  }]\n}",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MBzkzU0jc7m1gBTJ",
          "name": "Anthropic API"
        }
      }
    },
    {
      "id": "a4b-extract-prompt",
      "name": "Extract Image Prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-record-id",
              "name": "record_id",
              "value": "={{ $('Extract Record').first().json.record_id }}",
              "type": "number"
            },
            {
              "id": "assign-image-prompt",
              "name": "image_prompt",
              "value": "={{ $json.content[0].text.trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a4b-gen-image",
      "name": "Generate Image with OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/images/generations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ model: 'gpt-image-1', prompt: \"Minimal editorial line illustration. Fine cream (#FBFAF7) linework on a deep forest-green (#1E3B26) background, with a SINGLE brighter leaf-green (#67B035) accent element. Light isometric depth, generous negative space, thin consistent strokes. CRITICAL: render absolutely NO words, letters, numbers, labels or symbols anywhere - every document, page or surface must be blank or show only abstract horizontal line-marks, never real text. No logos, watermarks, UI, or people. No glowing neon, no robots, no brains. Premium, restrained, editorial. Keep all key elements within the central 80% of the frame. 16:9 wide.\" + ' Subject: ' + $json.image_prompt + '.', size: '1536x1024', n: 1, quality: 'medium' }) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "lXwN59cPwsZJ7KyS",
          "name": "OpenAI API Key (images)"
        }
      }
    },
