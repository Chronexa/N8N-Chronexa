      "position": [
        900,
        300
      ],
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "https://api.exa.ai/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "82046c22-fa17-4074-9511-2ff1abbe63a2"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $('Get Pending Record').first().json['Target Keyword'] }} {{ $('Get Pending Record').first().json['Persona'].replace(/_/g, ' ') }} statistics data case study operations 2025 2026\",\n  \"numResults\": 5,\n  \"type\": \"auto\",\n  \"startPublishedDate\": \"2025-01-01\",\n  \"contents\": {\n    \"summary\": {\n      \"query\": \"Extract: (1) specific statistics and percentages with sources, (2) real company or firm examples, (3) key operational pain points for the target business persona, (4) financial or efficiency impact numbers. Context: {{ $('Get Pending Record').first().json['Thesis'] }}\"\n    }\n  }\n}",
        "options": {
          "timeout": 60000
        }
      }
    },
