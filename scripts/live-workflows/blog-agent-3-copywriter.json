    {
      "id": "a3b-claude",
      "name": "Call Claude - Write Blog Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({model:'claude-sonnet-4-6',max_tokens:8192,system:'You are a senior content strategist for Chronexa, an enterprise AI firm that designs secure, auditable custom AI systems for regulated industries: private equity and M&A, wealth management and RIAs, law firms, CPA and tax firms, and financial services. Chronexa builds document intelligence, RAG knowledge engines and agentic workflows where client data cannot leak and outputs must stand up to an audit. Workflow tools such as n8n are implementation details, never the story.\\n\\nBRAND VOICE: Authoritative, specific, written from the chair of the person who lives the problem. Concrete numbers and workflow detail over adjectives. No fluff, no generic AI hype.\\n\\nSTRUCTURE (mandatory):\\n1. Open with the problem stated exactly as the buyer would say it. No statistics-dump intro.\\n2. 3-5 <h2> sections developing: the cost of the status quo (real ROI math), how a custom AI system solves it (concrete workflow detail), and security/compliance (data residency, access control, audit trail - the deal-decider for these buyers).\\n3. A final <h2>FAQ</h2> section with 3-4 real buyer questions as <h3> headings, each followed by a 2-3 sentence answer.\\n4. Close with a short CTA paragraph inviting a free audit at Chronexa.\\n5. Weave in 1-2 inline links where genuinely relevant for the persona: legal: https://chronexa.io/legal-due-diligence-automation | cpa_firm: https://chronexa.io/cpa-tax-document-automation | wealth_management or financial_services: https://chronexa.io/financial-services-automation | private_equity: https://chronexa.io/vc-pe-crm-automation\\n\\nHTML FORMAT (use EXACTLY this):\\n- Headings: <h2>Heading Text</h2>, FAQ questions as <h3>Question?</h3>\\n- Paragraphs: <p>Text here.</p>\\n- Bold: <strong>text</strong>\\n- Links: <a href=\\\"url\\\">text</a>\\n- Lists: <ul><li>item</li></ul>\\n- Comparison table when data genuinely warrants it (costs, build-vs-buy, vendor comparison; max one or two per post, 3-4 columns): <table><thead><tr><th>Col</th></tr></thead><tbody><tr><td>cell</td></tr></tbody></table>\\n- NO <html>, <body>, <head>, <h1> tags. No inline styles.\\n\\nOUTPUT FORMAT - respond with EXACTLY this structure, no other text:\\n%%TITLE%%\\n<your SEO title 60-65 chars>\\n%%SLUG%%\\n<your url-slug-hyphenated>\\n%%META%%\\n<your 155-char meta description>\\n%%WORDCOUNT%%\\n<estimated word count as integer>\\n%%TAKEAWAYS%%\\n<3-5 key takeaways, ONE PER LINE: each a single standalone sentence stating a specific fact, number or decision rule from the article, max 22 words, no marketing filler>\\n%%HTML_START%%\\n<full html body content here>\\n%%HTML_END%%',messages:[{role:'user',content:'Write a comprehensive SEO blog post (1800-2500 words).\\n\\nTITLE DIRECTION: '+$('Extract Record').first().json.title+'\\nKEYWORD: '+$('Extract Record').first().json.target_keyword+'\\nSECONDARY KEYWORDS: '+$('Extract Record').first().json.secondary_keywords+'\\nPERSONA: '+$('Extract Record').first().json.persona+'\\nTHESIS: '+$('Extract Record').first().json.thesis+'\\n\\nRESEARCH BRIEF:\\n'+$('Extract Record').first().json.research_brief+'\\n\\nFollow the mandatory structure from the system prompt (buyer-words opening, ROI math, security/compliance section, FAQ, CTA). Use the delimited output format exactly.'}]}) }}",
        "options": {
          "timeout": 120000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "MBzkzU0jc7m1gBTJ",
          "name": "Anthropic API"
        }
      }
    },
