      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        448,
        -176
      ],
      "parameters": {
        "content": "**The intelligence layer**\n\n1. Joins the lab result to every environment log for that room\n2. Averages VPD, temperature, humidity and CO₂ across the cycle\n3. Compares the outcome to the expected range\n4. Writes a plain-English insight and a recipe recommendation",
        "height": 404,
        "color": 4
