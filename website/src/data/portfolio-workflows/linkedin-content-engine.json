      "id": "sticky-overview",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -504,
        -280
      ],
      "parameters": {
        "content": "## LinkedIn content engine\n\n**Reference architecture.**\n\nTwice a week it researches your topics from RSS sources and an AI search, saves the raw material, and classifies what's relevant to your audience.\n\nFor each relevant story it picks a content pillar and drafts a post in your voice from real examples, then scores the draft.\n\nDrafts go to Slack. Reply with approve and it's published. Reply with feedback and it's rewritten and sent back for another look.",
        "width": 420,
        "height": 560,
        "color": 7
      }
    },
    {
      "id": "research-schedule",
      "name": "Research Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
