{
  "name": "Chronexa: Baserow → ManyReach Push",
  "nodes": [
    {
      "id": "trigger-node",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      }
    },
    {
      "id": "fetch-approved",
      "name": "Fetch Approved Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "parameters": {
        "method": "GET",
        "url": "https://api.baserow.io/api/database/rows/table/968761/?user_field_names=true&filter__Status__single_select_equal=6136390&size=50",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "{{BASEROW_TOKEN}}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "check-results",
      "name": "Any Approved Leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-leads",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "split-leads",
      "name": "Split Into Leads",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [960, 180],
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      }
    },
    {
      "id": "create-prospect",
      "name": "Create ManyReach Prospect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 180],
      "parameters": {
        "method": "POST",
        "url": "https://api.manyreach.com/api/v2/prospects",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "e905cb87-bf60-4257-82e9-9020547b7fd1" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({\n  \"email\":       $json['Email'] || '',\n  \"baseListId\":  95635,\n  \"firstName\":   $json['First Name'] || '',\n  \"lastName\":    $json['Last Name'] || '',\n  \"company\":     $json['Company Name'] || '',\n  \"domain\":      $json['Company Domain'] || '',\n  \"jobPosition\": $json['Title'] || '',\n  \"industry\":    $json['Industry'] || '',\n  \"companySize\": $json['Employees'] || '',\n  \"icebreaker\":  $json['Recent Trigger'] || '',\n  \"custom1\":     $json['Subject'] || '',\n  \"custom2\":     $json['Initial Email'] || '',\n  \"custom3\":     $json['Follow Up 1'] || '',\n  \"custom4\":     $json['Follow Up 2'] || '',\n  \"custom5\":     $json['Follow Up 3'] || '',\n  \"custom6\":     ($json['Status'] && $json['Status'].value) || 'Email Ready',\n  \"custom7\":     $json['Bucket'] || '',\n  \"notes\":       'Baserow ID: ' + $json['id']\n}) }}",
        "options": {}
      }
    },
    {
      "id": "add-to-campaign",
      "name": "Add to Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 180],
      "parameters": {
        "method": "POST",
        "url": "https://api.manyreach.com/api/v2/prospects/bulk?listId=95635&campaignId=91291&addOnlyIfNew=false&notInOtherCampaign=false",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "e905cb87-bf60-4257-82e9-9020547b7fd1" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ \"prospects\": [{ \"email\": $('Create ManyReach Prospect').item.json.email }] }) }}",
        "options": {}
      }
    },
    {
      "id": "update-baserow-status",
      "name": "Update Baserow → In Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 180],
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.baserow.io/api/database/rows/table/968761/{{ $('Split Into Leads').item.json.id }}/?user_field_names=true",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "{{BASEROW_TOKEN}}" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ \"Status\": \"In Campaign\" }) }}",
        "options": {}
      }
    },
    {
      "id": "done-nothing",
      "name": "No Leads to Process",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 420],
      "parameters": {}
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Fetch Approved Leads", "type": "main", "index": 0 }]]
    },
    "Fetch Approved Leads": {
      "main": [[{ "node": "Any Approved Leads?", "type": "main", "index": 0 }]]
    },
    "Any Approved Leads?": {
      "main": [
        [{ "node": "Split Into Leads", "type": "main", "index": 0 }],
        [{ "node": "No Leads to Process", "type": "main", "index": 0 }]
      ]
    },
    "Split Into Leads": {
      "main": [[{ "node": "Create ManyReach Prospect", "type": "main", "index": 0 }]]
    },
    "Create ManyReach Prospect": {
      "main": [[{ "node": "Add to Campaign", "type": "main", "index": 0 }]]
    },
    "Add to Campaign": {
      "main": [[{ "node": "Update Baserow → In Campaign", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
