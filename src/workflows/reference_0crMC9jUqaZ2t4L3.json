    {
      "parameters": {
        "jsCode": "// Get property info from earlier node\nconst propertyInfo = $('Get Property Info').first().json;\nconst propertyRecordId = propertyInfo.id;\n\n// Get all photos for this property to count categorized ones\nconst allPhotos = $('Update Photo Record').all();\n\n// Count categorized photos\nconst categorizedCount = allPhotos.filter(photo => \n  photo.json.fields.Status === 'Categorized' || \n  photo.json.fields.Status === 'Review Needed'\n).length;\n\n// Total photos is the count of all photos processed\nconst totalPhotos = allPhotos.length;\n\n// Determine status\nlet status;\nif (categorizedCount === 0) {\n  status = 'Not Started';\n} else if (categorizedCount < totalPhotos) {\n  status = 'In Progress';\n} else {\n  status = 'Completed';\n}\n\nreturn [{\n  json: {\n    propertyRecordId: propertyRecordId,\n    totalPhotos: totalPhotos,\n    categorizedPhotos: categorizedCount,\n    status: status\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
